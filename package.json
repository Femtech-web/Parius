{
  "name": "parius",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --experimental-test-isolation=none --test-timeout=20000 tests/*.test.ts",
    "fonts": "node scripts/setup-fonts.mjs",
    "format": "prettier --write src tests scripts *.json *.mjs *.ts",
    "jobs": "node --import tsx scripts/run-background.mts once",
    "jobs:watch": "node --import tsx scripts/run-background.mts watch",
    "jobs:status": "node --import tsx scripts/run-background.mts status",
    "agent:mcp": "node --import tsx scripts/agent-mcp.mts",
    "agent:payment": "node --import tsx scripts/agent-payment.mts"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.6",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@mysten-incubation/memwal": "0.1.9",
    "@mysten/dapp-kit-react": "2.1.41",
    "@mysten/enoki": "1.3.1",
    "@mysten/seal": "1.5.1",
    "@mysten/sui": "2.37.0",
    "@protobuf-ts/grpc-transport": "2.11.1",
    "@radix-ui/react-select": "^2.4.1",
    "@suimpp/mpp": "0.9.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "groq-sdk": "1.6.0",
    "gsap": "^3.15.0",
    "lucide-react": "1.61.0",
    "mppx": "0.4.11",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "three": "^0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.186.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.8.0"
  },
  "packageManager": "pnpm@10.30.2"
}
