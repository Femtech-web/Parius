NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional privileged operations only; never prefix server secrets with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
GROQ_API_KEY=
GROQ_SCOPE_MODEL=openai/gpt-oss-120b
GROQ_DRAFT_MODEL=openai/gpt-oss-20b
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_RELAYER_URL=https://relayer.memory.walrus.xyz
TATUM_API_KEY=
TATUM_SUI_GRPC_URL=https://sui-testnet-grpc.gateway.tatum.io
NEXT_PUBLIC_ENOKI_API_KEY=
# Server-only sponsorship key. Ownership linking does not require this key.
ENOKI_PRIVATE_API_KEY=
# OAuth Web client; redirect URI: <app origin>/wallet/callback
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_SUI_NETWORK=testnet
# Optional: enable both after configuring the per-network Tatum keys and migration 18.
NEXT_PUBLIC_SUI_NETWORKS=testnet
# Server-only; the legacy TATUM_API_KEY above remains the default network fallback.
TATUM_TESTNET_API_KEY=
TATUM_MAINNET_API_KEY=
TATUM_TESTNET_GRPC_URL=https://sui-testnet-grpc.gateway.tatum.io
TATUM_MAINNET_GRPC_URL=https://sui-mainnet-grpc.gateway.tatum.io

# Server-only random token for the protected background worker; minimum 32 characters.
BACKGROUND_WORKER_SECRET=

# Server-only key for project invitation emails (separate from Supabase Auth SMTP).
RESEND_API_KEY=
INVITE_EMAIL_FROM="Parius <notifications@paayee.org>"
